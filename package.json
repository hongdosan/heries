{
  "name": "heries",
  "version": "0.4.0",
  "private": true,
  "description": "H-eries — 홍도산의 오리지널 웹 시리즈 컬렉션. React 19 + Vite + TypeScript strict.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "author": "hongdosan",
  "homepage": "https://hongdosan.github.io/heries/",
  "repository": {
    "type": "git",
    "url": "https://github.com/hongdosan/heries.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-images.mjs && node scripts/check-manifest.mjs && tsc -b && vite build && node scripts/copy-content.mjs dist && cp .nojekyll dist/.nojekyll && node scripts/check-secrets.mjs dist",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "optimize:images": "node scripts/optimize-images.mjs",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "validate": "npm run lint && npm run typecheck && npm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@storybook/react-vite": "9.1.20",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitejs/plugin-react": "^5.2.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "storybook": "9.1.20",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.3",
    "eslint-plugin-storybook": "9.1.20",
    "@storybook/addon-docs": "9.1.20"
  }
}
